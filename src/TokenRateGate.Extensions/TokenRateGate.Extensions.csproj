<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net8.0;net9.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Package-specific Metadata -->
        <PackageId>TokenRateGate.Extensions</PackageId>
        <Description>Base implementations and extension methods for building rate-limited LLM clients with TokenRateGate. Prevents HTTP 429 errors across OpenAI, Azure OpenAI, and Anthropic APIs.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\TokenRateGate.Abstractions\TokenRateGate.Abstractions.csproj" />
        <ProjectReference Include="..\TokenRateGate.Core\TokenRateGate.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
    </ItemGroup>

</Project>
