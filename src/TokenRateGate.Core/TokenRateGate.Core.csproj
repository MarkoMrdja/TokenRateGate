<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package-specific Metadata -->
    <PackageId>TokenRateGate.Core</PackageId>
    <Description>Stop HTTP 429 "Rate limit exceeded" errors from LLM APIs. Complete rate limiting solution with TPM/RPM enforcement, dependency injection support, and character-based token estimation. Use this for custom LLM providers or without SDK integrations. For OpenAI/Azure, install TokenRateGate instead.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TokenRateGate.Abstractions\TokenRateGate.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TokenRateGate.Core.Tests" />
    <InternalsVisibleTo Include="TokenRateGate.OpenAI.Tests" />
    <InternalsVisibleTo Include="TokenRateGate.IntegrationTests" />
  </ItemGroup>

</Project>
