<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net8.0;net9.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Package Metadata -->
        <PackageId>TokenRateGate.Extensions.DependencyInjection</PackageId>
        <Version>1.0.0-alpha.1</Version>
        <Authors>TokenRateGate Contributors</Authors>
        <Description>Dependency injection extensions for TokenRateGate enabling easy integration with ASP.NET Core and other .NET applications</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/markomrdja/TokenRateGate</PackageProjectUrl>
        <RepositoryUrl>https://github.com/markomrdja/TokenRateGate</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>rate-limiting;llm;openai;tokens;api;rate-limit;dependency-injection;di</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\TokenRateGate.Abstractions\TokenRateGate.Abstractions.csproj" />
        <ProjectReference Include="..\TokenRateGate.Core\TokenRateGate.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.7" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.7" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.7" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.7" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
    </ItemGroup>

</Project>
