<Project>
  <PropertyGroup>
    <!-- Package Metadata -->
    <Authors>Marko Mrdja</Authors>
    <Company>Marko Mrdja</Company>
    <Copyright>Copyright © 2025 Marko Mrdja</Copyright>

    <!-- Version -->
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>

    <!-- NuGet Package Settings -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/markomrdja/TokenRateGate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/markomrdja/TokenRateGate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Common Tags (SEO-optimized for HTTP 429 errors) -->
    <PackageTags>rate-limiting;llm;openai;azure-openai;anthropic;http-429;rate-limit-exceeded;token-bucket;api-throttling;concurrency-control;tpm;rpm;azure-ai-foundry</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>
      v0.9.0 (Public Beta)
      - Initial public release
      - Solves HTTP 429 "Rate limit exceeded" errors for Azure OpenAI, OpenAI, and Anthropic APIs
      - Token-based rate limiting (TPM - Tokens Per Minute)
      - Request-based rate limiting (RPM - Requests Per Minute)
      - Smart queuing with timeout support
      - Safety buffer to prevent exact limit hits
      - Comprehensive integration with OpenAI and Azure SDKs
      - Multi-framework support (.NET 6.0, 8.0, 9.0)
    </PackageReleaseNotes>

    <!-- Source Link Support -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Build Settings -->
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Include README in all packages -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
